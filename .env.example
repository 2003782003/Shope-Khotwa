# ─────────────────────────────────────────────────────────────
# KHOTWA environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Only variables prefixed with VITE_ reach the browser bundle.
# Everything else is server-only and must never get a VITE_ prefix.
# ─────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (CORS allowlist).
# Production values MUST use https://.
APP_ORIGIN=http://localhost:5173

# ── Database (PostgreSQL) ────────────────────────────────────
# Use the least-privilege role created by database/schema.sql (khotwa_app).
DATABASE_URL=postgresql://khotwa_app:CHANGE_ME@localhost:5432/khotwa
DB_SSL=false
DB_POOL_MAX=10

# ── Sessions & cookies ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_at_least_32_random_characters
SESSION_TTL_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.khotwa.dz

# ── Password reset ───────────────────────────────────────────
PASSWORD_RESET_TTL_MINUTES=20
PUBLIC_APP_URL=http://localhost:5173

# ── Staff email login code (admin/manager only) ──────────────
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
# Development only. Must be false in production.
EXPOSE_DEV_EMAIL_CODE=false

# ── Payments ─────────────────────────────────────────────────
# Shared secret used for X-Khotwa-Signature HMAC webhooks. Min 16 chars.
# PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# ── Outbound email (password reset + staff login codes) ─────
# Required in production for staff login codes and password reset links.
# The webhook receives { from, to, subject, text } with a bearer key.
# MAIL_WEBHOOK_URL=https://mail.example.com/send
# MAIL_WEBHOOK_KEY=
MAIL_FROM=KHOTWA <no-reply@khotwa.dz>

# ── Security alerts (brute force) ────────────────────────────
# ALERT_WEBHOOK_URL=https://hooks.example.com/khotwa-alerts
LOGIN_ALERT_THRESHOLD=10

# ── Uploads ──────────────────────────────────────────────────
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_BYTES=2097152

# ── Network ──────────────────────────────────────────────────
TRUST_PROXY=1
BODY_LIMIT=100kb

# ── In-memory DB (tests/demo only, never production) ─────────
ALLOW_MEMORY_DB=false

# ── Client (Vite) ────────────────────────────────────────────
# Leave empty when the API is served from the same origin (Vercel rewrite).
VITE_API_URL=
# Local dev proxy target for `npm run dev`.
VITE_DEV_API_URL=http://localhost:4000
